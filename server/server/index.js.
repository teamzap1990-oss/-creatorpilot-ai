export default {
  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === "/") {
      return Response.json({
        name: "CreatorPilot AI",
        status: "running",
        message: "Добро пожаловать в CreatorPilot AI!"
      });
    }

    if (url.pathname === "/health") {
      return Response.json({
        status: "ok"
      });
    }

    return Response.json({
      error: "Not found"
    }, { status: 404 });
  }
};
