const express = require("express");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    name: "CreatorPilot AI",
    status: "Backend is running",
    message: "Добро пожаловать в CreatorPilot AI!"
  });
});

app.get("/health", (req, res) => {
  res.json({
    status: "ok"
  });
});

app.listen(PORT, () => {
  console.log(`CreatorPilot AI запущен на порту ${PORT}`);
});
